<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scuola Digitale - Smart Theme</title>
    <style>
        /* Variabili di base (Tema Chiaro di default) */
        :root {
            --bg-body: #ffffff;
            --bg-nav: rgba(255, 255, 255, 0.8);
            --bg-card: #f5f5f7;
            --text-main: #1d1d1f;
            --text-sub: #86868b;
            --accent: #0071e3;
            --border: #d2d2d7;
        }

        /* Variabili Tema Scuro (Attivate dalla classe .dark-mode) */
        body.dark-mode {
            --bg-body: #000000;
            --bg-nav: rgba(0, 0, 0, 0.8);
            --bg-card: #1c1c1e;
            --text-main: #f5f5f7;
            --text-sub: #a1a1a6;
            --border: #333333;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            background-color: var(--bg-body);
            color: var(--text-main);
            transition: all 0.4s ease;
        }

        nav {
            background: var(--bg-nav);
            backdrop-filter: blur(10px);
            padding: 15px;
            position: sticky;
            top: 0;
            border-bottom: 1px solid var(--border);
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }

        nav a { text-decoration: none; color: var(--text-main); font-size: 14px; }

        .btn-toggle {
            background: var(--accent);
            color: white;
            border: none;
            padding: 5px 15px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12px;
        }

        header { text-align: center; padding: 80px 20px; background-color: var(--bg-card); }
        h1 { font-size: 48px; margin-bottom: 10px; }
        .subtitle { font-size: 24px; color: var(--text-sub); }
        
        .section {
            max-width: 1000px;
            margin: 40px auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .card {
            background: var(--bg-card);
            padding: 25px;
            border-radius: 18px;
            border: 1px solid var(--border);
        }

        .card h3 { color: var(--accent); margin-top: 0; }
    </style>
</head>
<body id="corpo">

    <nav>
        <a href="#">Home</a>
        <a href="#">Orario</a>
        <button class="btn-toggle" onclick="cambiaTema()">Switch Mode</button>
    </nav>

    <header>
        <h1>Scuola Digitale</h1>
        <p class="subtitle">Il tuo hub per lo studio.</p>
    </header>

    <div class="section">
        <div class="card">
            <h3>📚 Risorse</h3>
            <p>Accedi ai PDF caricati dai professori.</p>
        </div>
        <div class="card">
            <h3>📅 Agenda</h3>
            <p>Controlla le scadenze dei prossimi compiti.</p>
        </div>
    </div>

    <script>
        function cambiaTema() {
            // Seleziona il body e "shakerra" la classe dark-mode
            document.body.classList.toggle("dark-mode");
        }
    </script>

</body>
</html>
<meta property="og:title" content="Tech Vision - Il Futuro è Qui">
<meta property="og:description" content="Esplora l'innovazione tecnologica con un click.">
